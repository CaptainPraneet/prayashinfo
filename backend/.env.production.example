# Server Port
PORT=4000
NODE_ENV=production

# MongoDB Atlas Connection URI (Ensure 0.0.0.0/0 is whitelisted in Atlas Network Access)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net

# JWT Secret Key (Generate with: openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_here

# Super Admin Credentials
ADMIN_EMAIL=admin@appointy.com
ADMIN_PASSWORD=change_this_admin_password_in_production

# Razorpay Payment Gateway (Live keys for production)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
CURRENCY=INR

# Cloudinary Storage for Doctor & Patient Profile Images
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_secret_key

# Nodemailer / SMTP Email Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your_clinic_email@gmail.com
EMAIL_PASS=your_app_specific_password
EMAIL_FROM="PrayashCare <noreply@example.com>"
PUBLIC_APP_URL=https://prayashcare.yourdomain.com

# Meta WhatsApp Cloud API (Optional - for automated WhatsApp reminders)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Allowed Frontend Origins (Comma-separated for CORS whitelist)
ALLOWED_ORIGINS=https://prayashcare.yourdomain.com,https://admin.prayashcare.yourdomain.com
